#######################################
# check-sources (Core/Src/*.c ile C_SOURCES arasinda drift bekcisi)
#######################################
# CubeMX regenerate C_SOURCES'i sifirlayabildigi icin elle eklenen
# kaynaklarin (lora.c, telemetry.c gibi) listeden dusmesini erken yakalar.
check-sources:
	@for f in Core/Src/*.c; do \
		case " $(C_SOURCES) " in \
			*" $$f "*) ;; \
			*) echo "HATA: C_SOURCES'ta eksik: $$f"; exit 1 ;; \
		esac; \
	done; \
	echo "OK: Core/Src/*.c tumu C_SOURCES'ta mevcut."

